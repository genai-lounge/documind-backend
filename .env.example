# Backend environment variables (copy to .env and fill in real values).
# Every variable below has a default, so .env is optional in Phase 1.
# Load it with: uv run --env-file .env uvicorn app.main:app --reload --port 8008

# Largest accepted upload, in megabytes.
MAX_UPLOAD_SIZE_MB=10

# Browser origins allowed to call the API (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:3008

# Later phases will add, for example:
# ANTHROPIC_API_KEY=your-api-key-here
